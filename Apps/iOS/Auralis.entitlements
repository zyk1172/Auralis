<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Siri 能力（com.apple.developer.siri）默认不声明。

	  Apple 不允许 Personal Team（免费 Apple ID）使用 Siri capability，
	  携带该 entitlement 时签名阶段必然失败：
	    "Personal development teams ... do not support the Siri capability."

	  只有在付费 Apple Developer Program 团队、且 App ID 已开启 Siri 能力后，
	  才可在此处加回：
	    <key>com.apple.developer.siri</key>
	    <true/>
	  详见 Docs/SiriMediaIntegration.md 第 4 节。
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.auralis.player</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.auralis.player.ios</string>
	</array>
</dict>
</plist>
