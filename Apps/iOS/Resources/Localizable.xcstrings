          "stringUnit": {
            "state": "translated",
            "value": "Preferences are stored locally for ranking and prompts; never uploaded and never contain server info."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偏好只儲存在本機，用於本地排序與提示詞；不會上傳，也不會包含伺服器資訊。"
