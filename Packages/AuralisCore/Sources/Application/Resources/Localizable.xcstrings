{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "，请检查网络连接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " - please check the network connection"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "，請檢查網路連線"
          }
        }
      }
    },
    "。若是局域网地址（\\(host)），请检查 系统设置 → 隐私与安全性 → 本地网络 是否允许「Auralis」访问本地网络，并确认 Mac 与服务器在同一网络。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this is a LAN address (\\(host)), make sure Auralis is allowed to access your local network under System Settings → Privacy & Security → Local Network, and that your Mac and the server are on the same network."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "。若是區域網路地址（\\(host)），請檢查 系統設定 → 隱私與安全性 → 本地網路 是否允許「Auralis」訪問本地網路，併確認 Mac 與伺服器在同一網路。"
          }
        }
      }
    },
    "。若是局域网地址（\\(host)），请检查 设置 → 隐私与安全性 → 本地网络 是否允许「Auralis」访问本地网络，并确认设备与服务器在同一网络。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this is a LAN address (\\(host)), make sure Auralis is allowed to access your local network under Settings → Privacy & Security → Local Network, and that the device and server are on the same network."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "。若是區域網路地址（\\(host)），請檢查 設定 → 隱私與安全性 → 本地網路 是否允許「Auralis」訪問本地網路，併確認裝置與伺服器在同一網路。"
          }
        }
      }
    },
    "。若是局域网地址（%@），请检查 系统设置 → 隐私与安全性 → 本地网络 是否允许「Auralis」访问本地网络，并确认 Mac 与服务器在同一网络。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this is a LAN address (%@), make sure Auralis is allowed to access your local network under System Settings → Privacy & Security → Local Network, and that your Mac and the server are on the same network."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "。若是區域網路地址（%@），請檢查 系統設定 → 隱私與安全性 → 本地網路 是否允許「Auralis」訪問本地網路，併確認 Mac 與伺服器在同一網路。"
          }
        }
      }
    },
    "。若是局域网地址（%@），请检查 设置 → 隐私与安全性 → 本地网络 是否允许「Auralis」访问本地网络，并确认设备与服务器在同一网络。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this is a LAN address (%@), make sure Auralis is allowed to access your local network under Settings → Privacy & Security → Local Network, and that the device and server are on the same network."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "。若是區域網路地址（%@），請檢查 設定 → 隱私與安全性 → 本地網路 是否允許「Auralis」訪問本地網路，併確認裝置與伺服器在同一網路。"
          }
        }
      }
    },
    "\\(message)（请核对「音乐下载」设置里的 Token）": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(message) (check the Token in Music Download settings)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(message)（請核对「音樂下載」設定裡的 Token）"
          }
        }
      }
    },
    "%@（请核对「音乐下载」设置里的 Token）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (check the Token in Music Download settings)"
