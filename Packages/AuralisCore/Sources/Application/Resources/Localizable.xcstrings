            "value": "%@（請核对「音樂下載」設定裡的 Token）"
          }
        }
      }
    },
    "HTTPS 连接失败（证书不受信任或被安全策略拦截）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS connection failed (certificate not trusted or blocked by a security policy)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS 連線失敗（證書不受信任或被安全策略拦截）"
          }
        }
      }
    },
    "保存资料库": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Library"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存資料庫"
          }
        }
      }
    },
    "保护凭据": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect Credentials"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護憑證"
          }
        }
      }
    },
    "公共网络服务器必须使用 HTTPS；HTTP 仅允许本机或私有局域网地址。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public servers must use HTTPS; HTTP is allowed only for local or private LAN addresses."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公共網路伺服器必須使用 HTTPS；HTTP 僅允許本機或私有區域網路地址。"
          }
        }
      }
    },
    "响应解析失败：\\(message)": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
