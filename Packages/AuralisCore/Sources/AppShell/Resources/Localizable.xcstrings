        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "默认只显示数量摘要，具体信息需手动展开。记忆与技能只存在本机 App Support，不会上传；每次 AI 对话开始时会按需注入相关记忆。"
          }
        },
