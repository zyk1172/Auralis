        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The library is stored in local SQLite (with a full-text search index), isolated per server. The assistant only queries the results you need and never sends your whole library to the model."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
