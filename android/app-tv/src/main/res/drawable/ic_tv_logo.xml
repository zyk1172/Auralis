<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV presentation wrapper for the current Apple Icon Composer master artwork.

    AuralisMaster.png contains the black export canvas that Icon Composer itself masks away on
    Apple platforms. Rendering that raw bitmap directly on Android exposed a black halo/rim around
    the rounded icon. Negative layer insets enlarge the artwork by ~12%, cropping that export canvas
    while preserving the actual icon artwork. Launcher/Leanback then apply their own platform mask.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-7dp"
        android:top="-7dp"
        android:right="-7dp"
        android:bottom="-7dp">
        <bitmap
            android:src="@drawable/auralis_apple_icon"
            android:gravity="fill" />
    </item>
</layer-list>
